#!/bin/bash

# script/logs: Follow the local Home Assistant development log

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$SCRIPT_DIR/.."

LOG_FILE="${PWD}/config/home-assistant.log"

if [[ ! -f $LOG_FILE ]]; then
    printf 'Home Assistant log not found: %s\n' "$LOG_FILE" >&2
    printf 'Start the local instance first with: ./script/develop\n' >&2
    exit 1
fi

printf 'Following %s (press Ctrl-C to stop)\n' "$LOG_FILE"
tail -n 200 -f "$LOG_FILE"
